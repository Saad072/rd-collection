# RD_COLLECTION server environment. Copy to .env and fill in.
NODE_ENV=development
PORT=4000

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/rd_collection

# JWT signing secret (required, min 16 chars)
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin(s), comma-separated (required for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Seed / admin bootstrap
ADMIN_EMAIL=admin@rdcollection.in
ADMIN_PASSWORD=Admin@123

# Razorpay (optional). When absent, the server uses a clearly-marked TEST adapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional). When absent, uploads are stored on local disk under ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local upload directory (used when Cloudinary is not configured)
UPLOAD_DIR=uploads
