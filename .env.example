# RD_COLLECTION — environment variables
# Copy to server/.env (backend) and set VITE_ vars in client/.env (frontend).
# PLACEHOLDER VALUES ONLY — never commit real secrets.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/rd_collection?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-string>
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@rdcollection.in
ADMIN_PASSWORD=<choose-a-strong-password-for-seed-bootstrap-only>

# Razorpay — use TEST keys (rzp_test_...) until launch.
# When absent, the server uses the simulated test payment adapter.
RAZORPAY_KEY_ID=rzp_test_00000000000000
RAZORPAY_KEY_SECRET=<razorpay-test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# Cloudinary — server-side signed uploads.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Frontend (client/.env)
VITE_API_BASE_URL=http://localhost:4000/api/v1
